table netdev perch_portal_acct
delete table netdev perch_portal_acct
table inet perch_portal_acct
delete table inet perch_portal_acct
table inet perch_portal_acct {
	set local4 {
		type ipv4_addr
		flags interval
		auto-merge
		elements = { 192.168.110.1, 192.168.20.1, 203.0.113.2, 224.0.0.0/4, 255.255.255.255 }
	}
	set local6 {
		type ipv6_addr
		flags interval
		auto-merge
		elements = { 2001:db8::1, fe80::/10, ff00::/8 }
	}
	set p3_ok {
		type ether_addr
		elements = { 02:00:00:00:20:11, 02:00:00:00:20:12 }
	}
	set p3_up {
		type ether_addr
		counter
		elements = { 02:00:00:00:20:11, 02:00:00:00:20:12 }
	}
	set p3_ip4 {
		type ipv4_addr
		size 65535
		flags dynamic,timeout
		timeout 2h
	}
	set p3_ip6 {
		type ipv6_addr
		size 65535
		flags dynamic,timeout
		timeout 2h
	}
	set p3_a4 {
		type ipv4_addr . ether_addr
		size 65535
		flags dynamic,timeout
		timeout 2h
	}
	set p3_a6 {
		type ipv6_addr . ether_addr
		size 65535
		flags dynamic,timeout
		timeout 2h
	}
	set p3_d4 {
		type ipv4_addr
		size 65535
		flags dynamic,timeout
		timeout 2h
		counter
	}
	set p3_d6 {
		type ipv6_addr
		size 65535
		flags dynamic,timeout
		timeout 2h
		counter
	}
	set p4_ok {
		type ether_addr
		elements = { 02:00:00:00:99:11 }
	}
	set p4_up {
		type ether_addr
		counter
		elements = { 02:00:00:00:99:11 }
	}
	set p4_ip4 {
		type ipv4_addr
		size 65535
		flags dynamic,timeout
		timeout 2h
	}
	set p4_ip6 {
		type ipv6_addr
		size 65535
		flags dynamic,timeout
		timeout 2h
	}
	set p4_a4 {
		type ipv4_addr . ether_addr
		size 65535
		flags dynamic,timeout
		timeout 2h
	}
	set p4_a6 {
		type ipv6_addr . ether_addr
		size 65535
		flags dynamic,timeout
		timeout 2h
	}
	set p4_d4 {
		type ipv4_addr
		size 65535
		flags dynamic,timeout
		timeout 2h
		counter
	}
	set p4_d6 {
		type ipv6_addr
		size 65535
		flags dynamic,timeout
		timeout 2h
		counter
	}
	chain p3_up {
		ip daddr @local4 return
		ip6 daddr @local6 return
		ether saddr @p3_up
		ether saddr @p3_ok update @p3_ip4 { ip saddr } update @p3_a4 { ip saddr . ether saddr }
		ether saddr @p3_ok update @p3_ip6 { ip6 saddr } update @p3_a6 { ip6 saddr . ether saddr }
	}
	chain p3_ingress {
		type filter hook ingress device "guest" priority -500; policy accept;
		meta mark set meta mark or 0x10000000 jump p3_up
	}
	chain p3_down {
		meta mark set meta mark or 0x10000000
		ip saddr @local4 return
		ip6 saddr @local6 return
		ip daddr @p3_ip4 update @p3_d4 { ip daddr }
		ip6 daddr @p3_ip6 update @p3_d6 { ip6 daddr }
	}
	chain p4_up {
		ip daddr @local4 return
		ip6 daddr @local6 return
		ether saddr @p4_up
		ether saddr @p4_ok update @p4_ip4 { ip saddr } update @p4_a4 { ip saddr . ether saddr }
		ether saddr @p4_ok update @p4_ip6 { ip6 saddr } update @p4_a6 { ip6 saddr . ether saddr }
	}
	chain p4_ingress {
		type filter hook ingress device "br-trunk.110" priority -500; policy accept;
		meta mark set meta mark or 0x10000000 jump p4_up
	}
	chain p4_down {
		meta mark set meta mark or 0x10000000
		ip saddr @local4 return
		ip6 saddr @local6 return
		ip daddr @p4_ip4 update @p4_d4 { ip daddr }
		ip6 daddr @p4_ip6 update @p4_d6 { ip6 daddr }
	}
	chain prerouting {
		type filter hook prerouting priority -350; policy accept;
		iifname "guest" meta mark and 0x10000000 == 0x10000000 meta mark set meta mark and 0xefffffff accept
		iifname "guest" jump p3_up
		iifname "br-trunk.110" meta mark and 0x10000000 == 0x10000000 meta mark set meta mark and 0xefffffff accept
		iifname "br-trunk.110" jump p4_up
	}
	chain postrouting {
		type filter hook postrouting priority 350; policy accept;
		oifname "guest" jump p3_down
		oifname "br-trunk.110" jump p4_down
	}
}
