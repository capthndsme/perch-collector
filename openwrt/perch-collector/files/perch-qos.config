# Perch traffic shaping: per-device and bucket caps on the LAN side
# (ifb-pdn download, ifb-pup upload). The Perch controller writes this file
# through its config plane; edits made here are drift and are overwritten
# on its next apply, except one: option enabled '0' is a local pause the
# controller shows and never reverts. `perch-collector qos stop` also
# pauses (until `qos apply` or a reboot). sqm on the WAN is not touched.
config globals 'globals'
	option enabled '1'
