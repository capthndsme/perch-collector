#!/bin/sh /etc/rc.common
# Perch boot guard, before the network. First the update step: when the router
# restarted while a collector update was being checked, put the previous version
# back (shell only, so it works whatever state the new binary is in). Then the
# config plane step: restore configs an unconfirmed apply changed.
START=15

start() {
	local s=/etc/perch-collector/update/perch-update.sh
	[ -x "$s" ] && "$s" boot /etc/perch-collector/update 2>&1 | logger -t perch-collector-guard
	[ -x /usr/bin/perch-collector ] || return 0
	/usr/bin/perch-collector config-guard 2>&1 | logger -t perch-collector-guard
	return 0
}
