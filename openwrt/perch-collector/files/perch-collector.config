# Perch Network Collector. Everything here maps onto the daemon's settings
# (see CONFIG.md in the source); the init script turns it into environment
# variables. `uci set perch-collector.main.<option>=...; uci commit;
# /etc/init.d/perch-collector restart` to change.
config collector 'main'
	option enabled '1'

	# The Perch Network Controller, e.g. 'https://perch.example.com'. The
	# collector dials it over a WebSocket and shows up under Settings →
	# Collectors, pending adoption; nothing is sent until then. Empty = the
	# collector talks to no controller and can only be polled.
	option server_url ''
	# 'auto' (a WebSocket, since the key below always exists), 'websocket',
	# or 'poll': announce over HTTP and be polled on the API address, which
	# then has to be reachable (listen_network 'lan').
	option transport 'auto'
	# Include the API key in the hello so adoption needs no copying. '0' =
	# send its fingerprint only and paste the key into the dashboard.
	option announce_api_key '1'
	# Accept a self-signed certificate on an https server_url, or trust a
	# private CA (PEM file).
	option announce_tls_insecure '0'
	# option server_ca_file '/etc/ssl/perch-ca.pem'
	# Stable identity the controller knows this router by; generated on
	# first start. Seconds between HTTP announces (transport 'poll' only).
	option instance_id ''
	option announce_interval '60'

	# The router's own health (connection tracking, established TCP, load,
	# memory, WAN rate) for the controller's Gateway page. 'auto' = on,
	# since the package runs on the router; 'on' / 'off' force it.
	option gateway_stats 'auto'
	# WAN interfaces the rate is counted on: UCI networks ('wan') or devices
	# ('pppoe-wan'). Empty = the interfaces holding a default route; set it
	# when WAN routes live outside the main table (mwan3, policy routing).
	# list wan_interface 'wan'
	# The router's Ethernet ports and their link state (carrier, speed,
	# duplex) for the controller's infrastructure view, sent with the gateway
	# stats: this is the Perch Network Gateway agent. The WAN interfaces are
	# role 'wan'. 'auto' = on whenever gateway_stats is; 'off' leaves them out.
	# Print them once with: perch-collector ports
	option ports 'auto'
	# The DHCP leases (dnsmasq, and odhcpd's when it runs) and the static
	# hosts of /etc/config/dhcp, so the controller names devices with nothing
	# to set up on its side. A change goes out with the next push; unchanged,
	# they are resent every dhcp_leases_refresh seconds (60-3600). 'auto' =
	# on, since the package runs on the router; 'off' stops it.
	# Print them once with: perch-collector dhcp
	option dhcp_leases 'auto'
	option dhcp_leases_refresh '600'
	# The rest of the router's runtime state for the managed gateway: the
	# neighbour table, the interfaces and their default routes, UPnP port
	# mappings, mwan3 (read only), who answers DNS, the board and release.
	# Read only, never config. Changes go out with the next push (the
	# neighbour table at most once a minute); unchanged parts are resent
	# every observe_refresh seconds (60-3600). 'auto' = on. observe_part
	# limits it to some parts: neighbors interfaces upnp mwan3 resolver system.
	# Print it once with: perch-collector observe
	option observe 'auto'
	option observe_refresh '600'
	# list observe_part 'neighbors'
	# Let the controller end a device's running connections when it blocks
	# the device (deletes its conntrack entries over netlink). 'auto' = on
	# with observe.
	option conntrack_flush 'auto'
	# Configuration backups (sysupgrade -b) the controller may take:
	# 'redacted' (passwords, keys and the like replaced, private key files
	# left out), 'full' (the archive as is, secrets included) or 'off'.
	option gateway_backup 'redacted'
	# Where the controller's last good address is kept: dialed when its name
	# does not resolve (broken DNS). Written only when the address changes.
	option controller_address_cache '/etc/perch-collector/controller-address'
	# Traffic shaping (per-device and bucket caps, the perch-qos package):
	# 'auto' = on when perch-qos is installed, 'off' = never.
	option qos 'auto'

	# The guest portal (captive portal), set up from the controller: Perch's
	# own nftables tables (inet perch_portal, netdev perch_portal_acct) on the
	# guest networks the controller names, and the guest pages on
	# portal_port. Nothing is captive until the controller configures a
	# portal. 'auto' = on with the WebSocket transport; '0' also removes any
	# enforcement a previous run left.
	option portal_enabled 'auto'
	option portal_port '2080'
	# Where grants, offline vouchers and the journal are kept across
	# reboots, and how often byte counters are written there (seconds;
	# '0' = by storage: every 300 s on flash, every tick on eMMC or a disk).
	# Grants are written at once. With portal_storage_mount set, the path
	# must be on that mount; when it is not mounted the state stays in RAM
	# and goes to the default path, never onto an empty mount point.
	# option portal_storage_path '/etc/perch-collector/portal/state.db'
	option portal_flush_interval '0'
	# option portal_storage_mount '/mnt/usb'

	# The config plane: may the controller see, and change, this router's
	# configuration? 'none' (default) = no; 'read' = it reads the configs
	# listed below (secrets such as Wi-Fi keys and passwords are replaced by
	# fingerprints and never leave the router) and is told when they change,
	# with who likely changed them (LuCI user or the command line); 'write' =
	# it may also change them. Every change is snapshotted first, and restored
	# on its own unless the controller confirms it over a fresh connection
	# within the confirm window (also after a reboot: perch-collector-guard).
	# This file itself, rpcd, uhttpd, dropbear, luci and perch-apd are never
	# readable or writable that way.
	# Print what it would see once with: perch-collector gateway-config
	option config_access 'none'
	list managed_config 'network'
	list managed_config 'dhcp'
	list managed_config 'firewall'
	# Installed sibling packages bring their config onto the allowlist by
	# themselves: sqm-scripts (sqm, the WAN queues) and perch-qos (the
	# shaper's package). '0' keeps the allowlist to managed_config; a single
	# one stays off with: list managed_config_exclude 'sqm'
	option managed_config_auto '1'
	# Writes need an https server_url with a verified certificate. '1' also
	# accepts them over plain http:// (or an unverified certificate) when the
	# controller signs each one (HMAC, with its own opt-in): integrity and
	# replay protection, not confidentiality.
	option config_allow_insecure '0'
	# The key of those signatures comes from pairing with the controller:
	# start it on the gateway's page, compare the 6-digit codes and confirm
	# here with: perch-collector pair confirm <code>  (see: perch-collector
	# pair status). The api_key never signs. A fixed key (16+ characters)
	# that you also paste into the controller replaces pairing:
	# option config_sign_key ''
	# The longest confirm window of a change, in seconds (30-3600).
	option config_confirm_max '600'
	# Packages the controller may install on top of its own list (sqm-scripts,
	# opennds, wireguard-tools, mwan3, pbr and their LuCI apps, ...).
	# list package_allow 'tcpdump-mini'
	# Where the collector would keep local state; its storage type (flash,
	# eMMC, SD, USB, SATA) is reported to the controller.
	option storage_path '/etc/perch-collector'

	# Where to capture. capture_networks: every LAN-side network ('auto':
	# each interface that is up, proto static or none, and not a WAN), or
	# UCI network names; each gets a capture (and nDPI engine) of its own,
	# and the daemon follows networks that appear or go away (re-read every
	# capture_rescan seconds and on interface events), without a restart.
	# capture_exclude leaves networks out (a guest network, for privacy).
	# Without capture_networks the collector captures one network (or one
	# device) as before: comment out capture_networks and set
	# capture_network 'lan' / capture_device 'br-lan'.
	list capture_networks 'auto'
	# list capture_exclude 'guest'
	option capture_rescan '30'
	# option capture_network 'lan'
	# option capture_device 'br-lan'
	# Traffic routed between two local networks, and traffic to the
	# router's own LAN addresses (DNS, the web UI), counts as LAN rather
	# than WAN. 'auto' = on with capture_networks, off with one network;
	# 'on' / 'off' force it.
	option routed_lan 'auto'

	# Where the local JSON API listens: the address of this UCI network plus
	# the port. 'loopback' keeps it on 127.0.0.1 for local checks, which is
	# all the WebSocket transport needs; use 'lan' to be polled, or
	# listen_address to force an address ('0.0.0.0' for everything).
	option listen_network 'loopback'
	option port '9800'
	# option listen_address ''

	# Bearer token for the local API and the collector's credential towards
	# the controller. Generated on first start when empty; read it with:
	# uci get perch-collector.main.api_key
	option api_key ''

	# 'ndpi' (application classification, needs the nDPI build) or 'port'.
	option classification 'ndpi'
	# Bytes captured per packet with classification 'port' (96 is enough).
	# 'ndpi' always captures whole packets, whatever this says.
	option snap_len '1500'
	option promiscuous '1'

	# Upstream gateway MACs. Empty = this router: the MAC of the capture
	# device, which is right when the daemon runs on the gateway itself.
	# list gateway_mac '02:00:00:00:00:01'

	# Extra CIDRs that count as local LAN (merged with the capture device's).
	# list local_subnet '10.0.0.0/8'

	# Optional BPF filter, e.g. 'not port 22'.
	option bpf_filter ''

	# Per-device caps (0 = built-in default, negative = off).
	option top_peers '50'
	option top_lan_peers '50'
	option top_services '500'
	option top_destinations '500'
	option top_unnamed_destinations '100'

	# nDPI flow table.
	option ndpi_max_flows '50000'
	option ndpi_flow_idle_seconds '120'
	# Packets a flow keeps native nDPI state after its first label; lower = less RAM.
	option ndpi_partial_extra_packets '4'
	# With capture_networks: 'shared' runs one nDPI module (about 12 MB) for
	# every network, each with a flow table of its own; 'per_network' gives
	# each network a module of its own (about 12 MB more per network, the
	# nDPI work spread over the CPUs). ndpi_max_flows is split across them.
	option ndpi_module 'shared'
