# Perch Network Collector. Everything here maps onto the daemon's settings
# (see CONFIG.md in the source); the init script turns it into environment
# variables. `uci set perch-collector.main.<option>=...; uci commit;
# /etc/init.d/perch-collector restart` to change.
config collector 'main'
	option enabled '1'

	# The Perch Network Controller, e.g. 'https://perch.example.com'. The
	# collector dials it over a WebSocket and shows up under Settings →
	# Collectors, pending adoption; nothing is sent until then. Empty = the
	# collector talks to no controller and can only be polled.
	option server_url ''
	# 'auto' (a WebSocket, since the key below always exists), 'websocket',
	# or 'poll': announce over HTTP and be polled on the API address, which
	# then has to be reachable (listen_network 'lan').
	option transport 'auto'
	# Include the API key in the hello so adoption needs no copying. '0' =
	# send its fingerprint only and paste the key into the dashboard.
	option announce_api_key '1'
	# Accept a self-signed certificate on an https server_url, or trust a
	# private CA (PEM file).
	option announce_tls_insecure '0'
	# option server_ca_file '/etc/ssl/perch-ca.pem'
	# Stable identity the controller knows this router by; generated on
	# first start. Seconds between HTTP announces (transport 'poll' only).
	option instance_id ''
	option announce_interval '60'

	# The router's own health (connection tracking, established TCP, load,
	# memory, WAN rate) for the controller's Gateway page. 'auto' = on,
	# since the package runs on the router; 'on' / 'off' force it.
	option gateway_stats 'auto'
	# WAN interfaces the rate is counted on: UCI networks ('wan') or devices
	# ('pppoe-wan'). Empty = the interfaces holding a default route; set it
	# when WAN routes live outside the main table (mwan3, policy routing).
	# list wan_interface 'wan'
	# The router's Ethernet ports and their link state (carrier, speed,
	# duplex) for the controller's infrastructure view, sent with the gateway
	# stats: this is the Perch Network Gateway agent. The WAN interfaces are
	# role 'wan'. 'auto' = on whenever gateway_stats is; 'off' leaves them out.
	# Print them once with: perch-collector ports
	option ports 'auto'
	# The DHCP leases (dnsmasq, and odhcpd's when it runs) and the static
	# hosts of /etc/config/dhcp, so the controller names devices with nothing
	# to set up on its side. A change goes out with the next push; unchanged,
	# they are resent every dhcp_leases_refresh seconds (60-3600). 'auto' =
	# on, since the package runs on the router; 'off' stops it.
	# Print them once with: perch-collector dhcp
	option dhcp_leases 'auto'
	option dhcp_leases_refresh '600'

	# Where to capture. Either a UCI network (its device, e.g. br-lan for
	# 'lan') or an explicit device in 'capture_device'.
	option capture_network 'lan'
	# option capture_device 'br-lan'

	# Where the local JSON API listens: the address of this UCI network plus
	# the port. 'loopback' keeps it on 127.0.0.1 for local checks, which is
	# all the WebSocket transport needs; use 'lan' to be polled, or
	# listen_address to force an address ('0.0.0.0' for everything).
	option listen_network 'loopback'
	option port '9800'
	# option listen_address ''

	# Bearer token for the local API and the collector's credential towards
	# the controller. Generated on first start when empty; read it with:
	# uci get perch-collector.main.api_key
	option api_key ''

	# 'ndpi' (application classification, needs the nDPI build) or 'port'.
	option classification 'ndpi'
	# Bytes captured per packet: 96 is enough for 'port', 1500 gives nDPI
	# the full picture (256 already covers the TLS ClientHello).
	option snap_len '1500'
	option promiscuous '1'

	# Upstream gateway MACs. Empty = this router: the MAC of the capture
	# device, which is right when the daemon runs on the gateway itself.
	# list gateway_mac '02:00:00:00:00:01'

	# Extra CIDRs that count as local LAN (merged with the capture device's).
	# list local_subnet '10.0.0.0/8'

	# Optional BPF filter, e.g. 'not port 22'.
	option bpf_filter ''

	# Per-device caps (0 = built-in default, negative = off).
	option top_peers '50'
	option top_lan_peers '50'
	option top_services '500'
	option top_destinations '500'
	option top_unnamed_destinations '100'

	# nDPI flow table.
	option ndpi_max_flows '50000'
	option ndpi_flow_idle_seconds '120'
	# Packets a flow keeps native nDPI state after its first label; lower = less RAM.
	option ndpi_partial_extra_packets '4'
